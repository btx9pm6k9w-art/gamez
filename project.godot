; Engine configuration file.
; GameZ: Fracture Line. Target engine: Godot 4.7 (Forward+, Metal on macOS).

config_version=5

[application]

config/name="GameZ: Fracture Line"
config/description="Modern-war RTS prototype"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[audio]

general/text_to_speech=true

[autoload]

GameSettings="*res://scripts/autoload/game_settings.gd"
VFX="*res://scripts/autoload/vfx.gd"
Audio="*res://scripts/audio/audio.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=2
window/vsync/vsync_mode=1
window/stretch/aspect="expand"
window/dpi/allow_hidpi=true
window/hdr/request_hdr_output=true

[navigation]

3d/default_cell_size=0.5
3d/default_cell_height=0.25

[rendering]

renderer/rendering_method="forward_plus"
rendering_device/driver.macos="metal"
viewport/hdr_2d=true
anti_aliasing/quality/use_taa=true
anti_aliasing/quality/use_debanding=true
anti_aliasing/screen_space_roughness_limiter/enabled=true
textures/default_filters/anisotropic_filtering_level=4
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=4
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=3
global_illumination/sdfgi/probe_ray_count=3
global_illumination/sdfgi/frames_to_converge=2
environment/ssao/quality=3
environment/ssil/quality=3
environment/volumetric_fog/volume_size=128
environment/volumetric_fog/volume_depth=96
scaling_3d/mode.macos=4
scaling_3d/scale=0.8
reflections/sky_reflections/ggx_samples=64
